# MongoDB
DB_URL=

# JWT
JWT_SECRET=

# Frontend and CORS
FRONTEND_URL=
CORS_ALLOWED_ORIGINS=

# Node environment
NODE_ENV=production

# SMTP (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Razorpay (optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: DNS servers for mongodb+srv
MONGO_DNS_SERVERS=8.8.8.8,8.8.4.4,1.1.1.1
# ==============================================================================
# YOURTUBE 2.0 - BACKEND ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env file to version control!

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# MongoDB connection string
# Get this from: MongoDB Atlas → Database → Connect → Drivers
DB_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/yourtube?retryWrites=true&w=majority&appName=Cluster0

# DNS servers for MongoDB SRV lookups (use if MongoDB connection fails on your network)
MONGO_DNS_SERVERS=8.8.8.8,8.8.4.4,1.1.1.1

# ==============================================================================
# JWT AUTHENTICATION
# ==============================================================================
# Secret key for signing JWT tokens - use a strong random string in production
# Generate using: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
# Backend server port
PORT=5000

# Frontend URL (for password reset links and CORS)
FRONTEND_URL=http://localhost:3000

# Allowed CORS origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Node environment (development, production, staging)
NODE_ENV=development

# ==============================================================================
# EMAIL/SMTP CONFIGURATION
# ==============================================================================
# For sending OTP, password reset emails, and notifications
# You can use either SMTP_* or EMAIL_* variable names (both are supported)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Alternate variable names (optional, for compatibility):
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password

# ==============================================================================
# PAYMENT INTEGRATION - RAZORPAY
# ==============================================================================
# Razorpay API keys for payment processing
# Get from: Razorpay Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==============================================================================
# OPTIONAL CONFIGURATION
# ==============================================================================
# Threshold for hiding comments based on dislike count
COMMENT_HIDE_THRESHOLD=2

# ==============================================================================
# PRODUCTION NOTES
# ==============================================================================
# For production deployment:
# 1. Use strong, randomly generated JWT_SECRET
# 2. Use production MongoDB Atlas URI
# 3. Set NODE_ENV=production
# 4. Use production Gmail/SMTP credentials or transactional email service
# 5. Use production Razorpay keys (not test keys)
# 6. Ensure FRONTEND_URL points to your production domain
# 7. Update CORS_ALLOWED_ORIGINS to production domain
# 8. Never commit .env file to version control
